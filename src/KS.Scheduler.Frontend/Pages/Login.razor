@page "/login"
@layout Layout.EmptyLayout
@inject NavigationManager NavManager
@inject KS.Scheduler.Frontend.Services.AuthService AuthService
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<PageTitle>Login - KS Scheduler</PageTitle>

<div class="login-container d-flex align-items-center justify-content-center">
    <div class="login-card animate-up">
        <div class="text-center mb-4">
            <div class="logo fw-bold text-white fs-2 mb-2">KS <span class="text-gradient">Scheduler</span></div>
        </div>

        <div class="login-form">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger py-2 text-center small mb-3">
                    @errorMessage
                </div>
            }

            <div class="mb-3">
                <label class="form-label text-white small fw-bold">E-MAIL</label>
                <input type="email"
                       class="form-control custom-input"
                       placeholder="ex: craque@bola.com"
                       @bind="email" />
            </div>

            <div class="mb-4">
                <div class="d-flex justify-content-between">
                    <label class="form-label text-white small fw-bold">SENHA</label>
                </div>

                <input type="password"
                       class="form-control custom-input"
                       placeholder="••••••••"
                       @bind="password"
                       @onkeyup="EnterKeyHandler" />

                <a href="#" class="small text-primary text-decoration-none">Esqueceu a senha?</a>
            </div>

            <button class="btn btn-cta w-100 mb-3"
                    @onclick="FazerLogin"
                    disabled="@isLoading">
                @(isLoading ? "ENTRANDO..." : "ENTRAR EM CAMPO")
            </button>

            <div class="text-center">
                <span class="text-gray small">Ainda não tem conta?</span>
                <a href="#" class="text-primary small fw-bold text-decoration-none ms-1">Criar conta</a>
            </div>
        </div>
    </div>
</div>

@code {
    private string email = "";
    private string password = "";
    private string errorMessage = "";
    private bool isLoading = false;

    private async Task FazerLogin()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Preencha todos os campos!";
            return;
        }

        try
        {
            isLoading = true;

            var request = new KS.Scheduler.Frontend.DTOs.Auth.LoginRequestDto
            {
                Email = email,
                Senha = password
            };

            var response = await AuthService.LoginAsync(request);

            if (response is null || string.IsNullOrWhiteSpace(response.Token))
            {
                errorMessage = "E-mail ou senha inválidos. Tente novamente.";
                return;
            }


            NavManager.NavigateTo("/home");
        }
        catch
        {
            errorMessage = "Erro ao tentar fazer login. Verifique a API.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task EnterKeyHandler(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await FazerLogin();
        }
    }
}